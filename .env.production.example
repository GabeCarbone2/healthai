# Copie para .env.production e substitua todos os valores de exemplo.
HEALTHAI_ENV=production
HEALTHAI_DATABASE_URL=sqlite:////app/data/healthai.db
HEALTHAI_DB_POOL_SIZE=5
HEALTHAI_DB_MAX_OVERFLOW=10
HEALTHAI_DB_POOL_TIMEOUT_SECONDS=30
HEALTHAI_DB_POOL_RECYCLE_SECONDS=1800
# Requer PostgreSQL no primário; use usuário read-only em cada URL de réplica.
HEALTHAI_READ_DATABASE_URLS=
HEALTHAI_READ_REPLICA_FALLBACK=true
HEALTHAI_FRONTEND_URL=https://healthai.net.br
HEALTHAI_TRUSTED_ORIGINS=https://healthai.net.br,https://www.healthai.net.br
HEALTHAI_PRIVACY_CONTACT=privacidade@healthai.net.br
HEALTHAI_RESULT_RETENTION_DAYS=180
HEALTHAI_CLEANUP_INTERVAL_SECONDS=3600
HEALTHAI_CRM_CHALLENGE_MINUTES=30
HEALTHAI_CRM_PDF_MAX_BYTES=10485760
HEALTHAI_CRM_REVOCATION_MODE=hard-fail
# Vazio usa a lista oficial do ITI. Opcionalmente informe um bundle PEM local.
HEALTHAI_ICP_BRASIL_TRUST_ROOTS=
HEALTHAI_TIMEZONE=America/Sao_Paulo
HEALTHAI_RATE_LIMIT_ENABLED=true
HEALTHAI_ENABLE_DOCS=false
HEALTHAI_EMAIL_DELIVERY=smtp
HEALTHAI_SMTP_HOST=smtp.hostinger.com
HEALTHAI_SMTP_PORT=465
HEALTHAI_SMTP_SECURITY=ssl
HEALTHAI_SMTP_USERNAME=nao-responda@healthai.net.br
HEALTHAI_SMTP_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_FORTE
HEALTHAI_EMAIL_FROM=HealthAI <nao-responda@healthai.net.br>
