HEALTHAI_DATABASE_URL=sqlite:///data/healthai.db
HEALTHAI_SECURE_COOKIE=false
HEALTHAI_RESULT_RETENTION_DAYS=180
HEALTHAI_PRIVACY_CONTACT=responsavel@example.com
HEALTHAI_FRONTEND_URL=http://127.0.0.1:5173
# Contas existentes ou futuras que devem receber a função administrativa.
HEALTHAI_ADMIN_EMAILS=
# Use "console" no desenvolvimento e "smtp" em produção.
HEALTHAI_EMAIL_DELIVERY=console
HEALTHAI_SMTP_HOST=smtp.hostinger.com
HEALTHAI_SMTP_PORT=465
HEALTHAI_SMTP_SECURITY=ssl
HEALTHAI_SMTP_USERNAME=nao-responda@example.com
HEALTHAI_SMTP_PASSWORD=
HEALTHAI_EMAIL_FROM=HealthAI <nao-responda@example.com>
