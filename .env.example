# Ambiente local. Não coloque segredos reais neste arquivo versionado.
HEALTHAI_ENV=development
HEALTHAI_DATABASE_URL=sqlite:///data/healthai.db
# Pool por processo da API. O limite é pool_size + max_overflow.
HEALTHAI_DB_POOL_SIZE=5
HEALTHAI_DB_MAX_OVERFLOW=10
HEALTHAI_DB_POOL_TIMEOUT_SECONDS=30
HEALTHAI_DB_POOL_RECYCLE_SECONDS=1800
# Réplicas PostgreSQL separadas por vírgula; vazio mantém leituras no primário.
HEALTHAI_READ_DATABASE_URLS=
HEALTHAI_READ_REPLICA_FALLBACK=true
HEALTHAI_FRONTEND_URL=http://127.0.0.1:5173
HEALTHAI_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HEALTHAI_PRIVACY_CONTACT=privacidade@example.com
HEALTHAI_RESULT_RETENTION_DAYS=180
HEALTHAI_CLEANUP_INTERVAL_SECONDS=3600
HEALTHAI_CRM_CHALLENGE_MINUTES=30
HEALTHAI_CRM_PDF_MAX_BYTES=10485760
# Em produção mantenha hard-fail. soft-fail serve apenas a testes locais.
HEALTHAI_CRM_REVOCATION_MODE=hard-fail
# Vazio usa a lista oficial do ITI. Opcionalmente informe um bundle PEM local.
HEALTHAI_ICP_BRASIL_TRUST_ROOTS=
HEALTHAI_TIMEZONE=America/Sao_Paulo
HEALTHAI_RATE_LIMIT_ENABLED=true
HEALTHAI_ENABLE_DOCS=true
HEALTHAI_EMAIL_DELIVERY=console
